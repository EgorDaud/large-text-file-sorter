<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FileSorter.Benchmarks</RootNamespace>

    <IsTestProject>false</IsTestProject>

    <!-- BenchmarkDotNet requires public benchmark members and owns their cleanup. -->
    <NoWarn>$(NoWarn);CA1515;CA1822;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FileSorter\FileSorter.csproj" />
    <ProjectReference Include="..\..\src\TestFileGenerator\TestFileGenerator.csproj" />
  </ItemGroup>

</Project>
