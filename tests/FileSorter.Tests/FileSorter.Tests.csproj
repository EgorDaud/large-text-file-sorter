<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>FileSorter.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FileSorter\FileSorter.csproj" />
    <!-- The cross-program round trip needs the generator's own production types, not a
         reimplementation of them, or a format drift between the two programs could
         hide behind a second, independently drifting test double. -->
    <ProjectReference Include="..\..\src\TestFileGenerator\TestFileGenerator.csproj" />
  </ItemGroup>

</Project>
